# ============================================================
# 폐쇄망 Claude-like 인터페이스 환경변수
# 사용법: cp .env.example .env  →  .env 편집 후 배포
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=litellm

# ── LiteLLM ──────────────────────────────────────────────────
# 모든 서비스가 LiteLLM 호출 시 사용하는 마스터 키
# openssl rand -hex 32 로 생성 권장
LITELLM_MASTER_KEY=sk-CHANGE_ME_LITELLM_MASTER_KEY

# ── vLLM (내부 GPU 서버) ──────────────────────────────────────
VLLM_API_KEY=internal-vllm-key
VLLM_MODEL_NAME=gptoss-120b
MODEL_PATH=/models                 # 호스트의 모델 가중치 경로
TENSOR_PARALLEL_SIZE=2             # GPU 수에 맞게 조정
MAX_MODEL_LEN=8192
VLLM_DTYPE=auto                    # auto | float16 | bfloat16

# ── HuggingFace (에어갭 환경에서는 불필요) ────────────────────
HF_TOKEN=

# ── Rebellions ATOM (사용 시 주석 해제) ───────────────────────
# REBEL_ATOM_API_BASE=http://rebel-atom-server:8080/v1
# REBEL_ATOM_API_KEY=rebel-internal-key

# ── Open WebUI ────────────────────────────────────────────────
# openssl rand -hex 32 로 생성 권장
WEBUI_SECRET_KEY=CHANGE_ME_WEBUI_SECRET_KEY
WEBUI_NAME=사내 AI 어시스턴트
DEFAULT_MODEL=gptoss-120b

# 신규 가입 허용 여부: false → 관리자가 직접 계정 생성
ENABLE_SIGNUP=false

# ── LDAP/SSO (Active Directory 연동 시 활성화) ────────────────
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OPENID_PROVIDER_URL=https://your-ad-server/.well-known/openid-configuration

# ── 관찰성 — Langfuse (선택) ──────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://langfuse:3000
