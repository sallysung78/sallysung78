# ============================================================
# OpenShift + OpenShift AI (RHOAI 3.4) on AWS — 설정 파일
# 사용법: cp cluster.env.example cluster.env → 값 채운 뒤 ./install-openshift-ai.sh
# cluster.env 는 .gitignore 되어 있으므로 절대 커밋되지 않습니다.
# ============================================================

# ── AWS ───────────────────────────────────────────────────────
# 계정: 061051233628 (콘솔 로그인 정보는 API 호출에 쓸 수 없음)
# IAM → 사용자 open-environment-njxfn-admin → 보안 자격 증명 → 액세스 키 만들기
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# ── 클러스터 ──────────────────────────────────────────────────
CLUSTER_NAME=rhoai
# Route53 에 Public Hosted Zone 이 있어야 함 (예: sandbox1785.opentlc.com)
# 비워두면 스크립트가 계정의 Hosted Zone 을 조회해 하나뿐이면 자동 선택
BASE_DOMAIN=
OCP_VERSION=stable-4.20        # stable-4.19 이상 (RHOAI 3.4 요구), stable-4.20 권장(llm-d)

MASTER_INSTANCE_TYPE=m6i.xlarge
MASTER_REPLICAS=3
WORKER_INSTANCE_TYPE=m6i.2xlarge
WORKER_REPLICAS=2

# ── Red Hat ───────────────────────────────────────────────────
# https://console.redhat.com/openshift/install/pull-secret 에서 다운로드
PULL_SECRET_PATH=$HOME/pull-secret.txt
SSH_KEY_PATH=$HOME/.ssh/id_ed25519      # 없으면 자동 생성

# ── RHOAI ─────────────────────────────────────────────────────
RHOAI_CHANNEL=stable-3.x       # 툴킷 기본 권장값
RHOAI_TOOLKIT_REF=9ff765be3a6a9cb308f94e3ced49b8d2b0f4a820   # 검증한 커밋(main 도 가능)
GPU_INSTANCE_TYPE=g6e.xlarge   # 1x L40S, 툴킷 기본값 (install-rhoai-34.sh 가 자동 생성)
INSTALL_RHOAI=true             # false 면 OpenShift 만 설치
RHOAI_EXTRA_ARGS=              # 예: --skip-maas --no-llmd --enable-observability
